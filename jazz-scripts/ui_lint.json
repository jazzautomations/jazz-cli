{"name": "ui_lint", "version": 1, "run": "python3", "effect": "read",
 "description": "Lint UI files (html/jsx/tsx/vue/svelte/astro/css): AI-design cliches, a11y basics, motion, tokens",
 "args": {"type": "object", "additionalProperties": false, "required": ["files"],
   "properties": {
     "files": {"type": "array", "items": {"type": "string"}, "description": "changed UI files, relative to the project root"},
     "max": {"type": "integer", "minimum": 1, "maximum": 200, "description": "findings returned at most (default 60)"}}},
 "output": {"data": {"findings": [{"file": "str", "line": "int", "rule": "str", "severity": "error|warn|info", "msg": "str"}],
   "summary": {"files": "int", "findings": "int", "errors": "int", "warnings": "int", "info": "int", "by_rule": "obj", "token_file": "str|null"},
   "skipped": [{"file": "str", "why": "str"}]}}}
