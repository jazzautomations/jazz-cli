{"name": "http_check", "version": 1, "run": "python3", "effect": "net",
 "description": "HTTP GET/HEAD a local or LAN URL: status, ms, key headers, body head (remote only with allow_remote)",
 "args": {"type": "object", "additionalProperties": false, "required": ["url"],
   "properties": {
     "url": {"type": "string"},
     "expect_status": {"type": "integer", "minimum": 100, "maximum": 599},
     "method": {"enum": ["GET", "HEAD"]},
     "timeout": {"type": "integer", "minimum": 1, "maximum": 30},
     "allow_remote": {"type": "boolean", "description": "permit a non-private host (asks in ask mode)"}}},
 "output": {"data": {"status": "int", "ms": "int", "headers": "obj", "body_head": "str", "matches_expected": "bool"}}}
