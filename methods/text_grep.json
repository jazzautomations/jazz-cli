          "op": "set"
        }
      ],
      "steps": [
        {
          "cap": "script:file_find",
          "in": {
            "path": "$slot.dir",
            "type": "file",
            "limit": "32"
          },
          "out": "cand"
        },
        {
          "cap": "for_each",
          "in": {
            "from": "$cand",
            "do": "script:text_grep",
            "pattern": "$slot.pattern",
            "max": "32"
          },
          "out": "fe"
        }
      ],
      "verify": [
        {
          "check": "each_clean",
          "arg": "$fe"
        }
      ],
      "risk": "low",
      "cost_ms": 3000
    },
