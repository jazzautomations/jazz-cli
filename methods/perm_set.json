  {
   "name": "perm_set.chmod",
   "intent": "perm_set",
   "priority": 10,
   "doc": "'chmod 755 em a.sh': perm_op confinado num arquivo, file_mode prova os bits reais",
   "pre": [
    {
     "fact": "slot.file",
     "op": "set"
    },
    {
     "fact": "slot.mode",
     "op": "set"
    },
    {
     "fact": "slot.owner",
     "op": "unset"
    },
    {
     "fact": "slot.group",
     "op": "unset"
    }
   ],
   "steps": [
    {
     "cap": "perm_op",
     "in": {
      "op": "chmod",
      "path": "$slot.file",
      "mode": "$slot.mode",
      "recursive": "$slot.recursive"
     },
     "out": "p"
    }
   ],
   "verify": [
    {
     "check": "file_mode",
     "arg": "$p",
     "arg2": "$slot.mode"
    }
   ],
   "risk": "medium",
   "cost_ms": 20
  },
