{
 "methods": [
  {
   "name": "perm_set.ownsrc",
   "intent": "perm_set",
   "priority": 8,
   "doc": "'chown files belonging to root to admin': perm_find escopa a fonte (owner), for_each chown, list_owner prova — nunca roda no conjunto inteiro",
   "needs": [
    "bin.python3"
   ],
   "pre": [
    {
     "fact": "slot.file",
     "op": "unset"
    },
    {
     "fact": "slot.owner",
     "op": "set"
    },
    {
     "fact": "slot.src_owner",
     "op": "set"
    },
    {
     "fact": "slot.mode",
     "op": "unset"
    },
    {
     "fact": "slot.ext",
     "op": "unset"
    }
   ],
   "steps": [
    {
     "cap": "script:perm_find",
     "in": {
      "path": "$slot.dir",
      "owner": "$slot.src_owner",
      "type": "$slot.type",
      "limit": "256"
     },
     "out": "cand"
    },
    {
     "cap": "for_each",
     "in": {
      "from": "$cand",
      "do": "perm_op",
      "op": "chown",
      "owner": "$slot.owner",
      "group": "$slot.group",
      "max": "256"
     },
     "out": "fe"
    }
   ],
   "verify": [
    {
     "check": "list_owner",
     "arg": "$cand",
     "arg2": "$slot.owner"
    }
   ],
   "risk": "high",
   "cost_ms": 400
  },
