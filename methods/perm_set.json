  {
   "name": "perm_set.each",
   "intent": "perm_set",
   "priority": 7,
   "doc": "'chmod 644 em todos os .txt': file_find por ext produz, for_each aplica, list_mode prova o lote",
   "needs": [
    "bin.python3"
   ],
   "pre": [
    {
     "fact": "slot.file",
     "op": "unset"
    },
    {
     "fact": "slot.ext",
     "op": "set"
    },
    {
     "fact": "slot.mode",
     "op": "set"
    }
   ],
   "steps": [
    {
     "cap": "script:file_find",
     "in": {
      "path": "$slot.dir",
      "name": "*.$slot.ext",
      "type": "file",
      "limit": "256"
     },
     "out": "cand"
    },
    {
     "cap": "for_each",
     "in": {
      "from": "$cand",
      "do": "perm_op",
      "op": "chmod",
      "mode": "$slot.mode",
      "max": "256"
     }
    }
   ],
   "verify": [
    {
     "check": "list_mode",
     "arg": "$cand",
     "arg2": "$slot.mode"
    }
   ],
   "risk": "high",
   "cost_ms": 200
  },
