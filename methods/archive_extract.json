{"methods": [
 {
  "name": "archive_extract.to",
  "intent": "archive_extract",
  "priority": 10,
  "doc": "archive_op extract nativo: magic bytes decidem o formato, membros unsafe/link são pulados, list_exists prova cada path produzido",
  "pre": [
   {"fact": "slot.arc", "op": "set"}
  ],
  "steps": [
   {"cap": "archive_op", "in": {"op": "extract", "arc": "$slot.arc", "dir": "$slot.dir"}, "out": "e"}
  ],
  "verify": [{"check": "list_exists", "arg": "$e"}],
  "risk": "medium",
  "cost_ms": 300
 },
 {
  "name": "archive_extract.each",
  "intent": "archive_extract",
  "priority": 9,
  "doc": "'unzip all *.zip files': file_find produz os archives do tipo, for_each extrai um a um no dir (teto 32)",
  "needs": ["bin.python3"],
  "pre": [
   {"fact": "slot.arc", "op": "unset"},
   {"fact": "slot.ext", "op": "set"}
  ],
  "steps": [
   {"cap": "script:file_find", "in": {"path": ".", "ext": "$slot.ext", "type": "file", "limit": "32"}, "out": "cand"},
   {"cap": "for_each", "in": {"from": "$cand", "do": "archive_op", "op": "extract", "dir": "$slot.dir", "max": "32"}, "out": "fe"}
  ],
  "verify": [{"check": "each_clean", "arg": "$fe"}],
  "risk": "medium",
  "cost_ms": 3000
 },
 {
  "name": "archive_extract.each_name",
  "intent": "archive_extract",
  "priority": 9,
  "doc": "'unzip all zip files' sem ponto-ext: file_find por *zip* produz, for_each extrai um a um no dir (teto 32)",
  "needs": ["bin.python3"],
  "pre": [
   {"fact": "slot.arc", "op": "unset"},
   {"fact": "slot.ext", "op": "unset"},
   {"fact": "slot.namepat", "op": "set"}
  ],
  "steps": [
   {"cap": "script:file_find", "in": {"path": ".", "name": "$slot.namepat", "type": "file", "limit": "32"}, "out": "cand"},
   {"cap": "for_each", "in": {"from": "$cand", "do": "archive_op", "op": "extract", "dir": "$slot.dir", "max": "32"}, "out": "fe"}
  ],
  "verify": [{"check": "each_clean", "arg": "$fe"}],
  "risk": "medium",
  "cost_ms": 3000
 },
 {
  "name": "archive_extract.ask",
  "intent": "archive_extract",
  "priority": 5,
  "doc": "sem archive no pedido: pergunta qual",
  "pre": [
   {"fact": "slot.arc", "op": "unset"}
  ],
  "steps": [
   {"cap": "ask_slot", "in": {"slot": "arc", "q": "Qual archive? (ex.: pack.tar.gz)"}, "out": "slot.arc"},
   {"cap": "archive_op", "in": {"op": "extract", "arc": "$slot.arc", "dir": "$slot.dir"}, "out": "e"}
  ],
  "verify": [{"check": "list_exists", "arg": "$e"}],
  "risk": "medium",
  "cost_ms": 300
 }
]}
