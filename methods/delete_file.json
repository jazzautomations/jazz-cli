{
 "methods": [
  {
   "name": "delete_file.op",
   "intent": "delete_file",
   "priority": 10,
   "doc": "file_op delete dentro do projeto; a permissão pede confirmação e o checkpoint cobre o /undo",
   "pre": [
    {
     "fact": "slot.target",
     "op": "set"
    }
   ],
   "steps": [
    {
     "cap": "file_op",
     "in": {
      "op": "delete",
      "path": "$slot.target"
     },
     "out": "d"
    }
   ],
   "verify": [
    {
     "check": "file_gone",
     "arg": "$slot.target"
    }
   ],
   "risk": "high",
   "cost_ms": 50
  },
  {
   "name": "delete_file.each",
   "intent": "delete_file",
   "priority": 8,
   "doc": "'apaga todos os .tmp': o filtro vai pro file_find e o for_each apaga um por vez (teto 32, cada um verificado)",
   "needs": [
    "bin.python3"
   ],
   "pre": [
    {
     "fact": "slot.target",
     "op": "unset"
    },
    {
     "fact": "slot.mass",
     "op": "set"
    }
   ],
   "steps": [
    {
     "cap": "need",
     "in": {
      "slots": "ext|name|newer|older|empty|min_size|max_size|name_re|exclude|dir|min_depth|max_depth|type"
     }
    },
    {
     "cap": "script:file_find",
     "in": {
      "path": "$slot.dir",
      "name": "$slot.name",
      "name_re": "$slot.name_re",
      "ext": "$slot.ext",
      "type": "$slot.type",
      "sort": "$slot.sort",
      "min_size": "$slot.min_size",
      "max_size": "$slot.max_size",
      "newer_min": "$slot.newer",
      "older_min": "$slot.older",
      "empty": "$slot.empty",
      "exclude": "$slot.exclude",
      "limit": "32",
      "icase": "$slot.icase",
      "newer_date": "$slot.newer_date",
      "older_date": "$slot.older_date"
     },
     "out": "cand"
    },
    {
     "cap": "for_each",
     "in": {
      "from": "$cand",
      "do": "file_op",
      "op": "delete",
      "max": "32"
     }
    }
   ],
   "risk": "high",
   "cost_ms": 400,
   "verify": [
    {
     "check": "list_gone",
     "arg": "$cand"
    }
   ]
  },
  {
   "name": "delete_file.ask",
   "intent": "delete_file",
   "priority": 1,
   "doc": "sem alvo: pergunta o que apagar",
   "pre": [
    {
     "fact": "slot.target",
     "op": "unset"
    }
   ],
   "steps": [
    {
     "cap": "ask_slot",
     "in": {
      "slot": "target",
      "q": "Apagar qual arquivo?"
     },
     "out": "slot.target"
    },
    {
     "cap": "file_op",
     "in": {
      "op": "delete",
      "path": "$slot.target"
     },
     "out": "d"
    }
   ],
   "verify": [
    {
     "check": "file_gone",
     "arg": "$slot.target"
    }
   ],
   "risk": "high",
   "cost_ms": 50
  }
 ]
}