  },
  {
   "name": "create.ask",
   "intent": "create",
   "priority": 1,
   "doc": "sem alvo: pergunta o caminho",
   "pre": [
    {
     "fact": "slot.scope",
     "op": "unset"
    },
    {
     "fact": "slot.targets",
     "op": "unset"
    },
    {
     "fact": "slot.target",
     "op": "unset"
    }
   ],
   "steps": [
    {
     "cap": "ask_slot",
     "in": {
