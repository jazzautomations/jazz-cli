    {
     "fact": "slot.type",
     "op": "eq",
     "val": "dir"
    }
   ],
   "steps": [
    {
     "cap": "file_op",
     "in": {
      "op": "mkdir",
      "path": "$slot.target"
     },
     "out": "f"
    }
   ],
   "verify": [
    {
