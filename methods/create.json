{
 "methods": [
  {
   "name": "create.dirs",
   "intent": "create",
   "priority": 13,
   "doc": "enumeração 'dirs X e Y': cada nome vira item do for_each (teto 32, cada mkdir verificado — sucesso só se TODOS existirem)",
   "pre": [
    {
     "fact": "slot.targets",
     "op": "set"
    },
    {
     "fact": "slot.type",
     "op": "eq",
     "val": "dir"
    }
   ],
   "steps": [
    {
     "cap": "enum",
     "in": {
      "names": "$slot.targets"
     },
     "out": "lst"
    },
    {
     "cap": "for_each",
     "in": {
      "from": "$lst",
      "do": "file_op",
      "op": "mkdir",
      "max": "32"
     },
     "out": "fx"
    }
   ],
   "verify": [
    {
     "check": "each_clean",
     "arg": "$fx"
    },
    {
     "check": "list_exists",
     "arg": "$lst"
    }
   ],
   "risk": "low",
   "cost_ms": 50
  },
  {
   "name": "create.dir_mode",
   "intent": "create",
   "priority": 13,
   "doc": "'create directory X with permissions 777': mkdir + chmod no mesmo alvo — sucesso só se a pasta existe E os bits batem",
   "pre": [
    {
     "fact": "slot.scope",
     "op": "unset"
    },
    {
     "fact": "slot.targets",
     "op": "unset"
    },
    {
     "fact": "slot.target",
     "op": "set"
    },
    {
     "fact": "slot.mode",
     "op": "set"
    },
    {
     "fact": "slot.type",
     "op": "eq",
     "val": "dir"
    }
   ],
   "steps": [
    {
     "cap": "file_op",
     "in": {
      "op": "mkdir",
      "path": "$slot.target"
     },
     "out": "f"
    },
    {
     "cap": "perm_op",
     "in": {
      "op": "chmod",
      "path": "$slot.target",
      "mode": "$slot.mode"
     },
     "out": "p"
    }
   ],
   "verify": [
    {
     "check": "file_exists",
     "arg": "$slot.target"
    },
    {
     "check": "file_mode",
     "arg": "$slot.target",
     "arg2": "$slot.mode"
    }
   ],
   "risk": "low",
   "cost_ms": 60
  },
  {
   "name": "create.dir",
   "intent": "create",
   "priority": 12,
   "doc": "file_op mkdir -p: pasta nova dentro do projeto (checkpoint → /undo)",
