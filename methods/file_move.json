{
 "methods": [
  {
   "name": "file_move.one",
   "intent": "file_move",
   "priority": 11,
   "doc": "chain an\u00e1fora: 'acha X e move eles pra DIR' \u2014 um rename por path produzido",
   "needs": [],
   "pre": [
    {
     "fact": "slot.target",
     "op": "set"
    },
    {
     "fact": "slot.dest",
     "op": "set"
    },
    {
     "fact": "slot.pat",
     "op": "unset"
    },
    {
     "fact": "slot.op",
     "op": "eq",
     "val": "rename"
    }
   ],
   "steps": [
    {
     "cap": "file_op",
     "in": {
      "op": "rename",
      "path": "$slot.target",
      "to_dir": "$slot.dest"
     },
     "out": "mv"
    }
   ],
   "verify": [
    {
     "check": "file_gone",
     "arg": "$slot.target"
    }
   ],
   "risk": "high",
   "cost_ms": 500
  },
  {
   "name": "file_move.one_copy",
   "intent": "file_move",
   "priority": 11,
   "doc": "copia alvo \u00fanico para o destino \u2014 fonte preservada, prova dos dois lados",
   "needs": [],
   "pre": [
    {
     "fact": "slot.target",
     "op": "set"
    },
    {
     "fact": "slot.dest",
     "op": "set"
    },
    {
     "fact": "slot.pat",
     "op": "unset"
    },
    {
     "fact": "slot.op",
     "op": "eq",
     "val": "copy"
    }
   ],
   "steps": [
    {
     "cap": "file_op",
     "in": {
      "op": "copy",
      "path": "$slot.target",
      "to": "$slot.dest"
     },
     "out": "mv"
    }
   ],
   "verify": [
    {
     "check": "file_exists",
     "arg": "$mv"
    },
    {
     "check": "file_exists",
     "arg": "$slot.target"
    }
   ],
   "risk": "med",
   "cost_ms": 500
  },
  {
   "name": "file_move.each",
   "intent": "file_move",
   "priority": 10,
   "doc": "move cada item do filtro para o destino \u2014 for_each rename",
   "needs": [],
   "pre": [
    {
     "fact": "slot.dest",
     "op": "set"
    },
    {
     "fact": "slot.pat",
     "op": "set"
    },
    {
     "fact": "slot.op",
     "op": "eq",
     "val": "rename"
    }
   ],
   "steps": [
    {
     "cap": "script:file_find",
     "in": {
      "path": "$slot.srcdir",
      "name": "$slot.pat",
      "type": "$slot.type",
      "exclude": "$slot.exclude",
      "limit": "32",
      "icase": "$slot.icase",
      "newer_date": "$slot.newer_date",
      "older_date": "$slot.older_date",
      "newer_min": "$slot.newer",
      "older_min": "$slot.older",
      "time_field": "$slot.tfield"
     },
     "out": "cand"
    },
    {
     "cap": "for_each",
     "in": {
      "from": "$cand",
      "do": "file_op",
      "op": "rename",
      "to_dir": "$slot.dest",
      "max": "32"
     },
     "out": "fe"
    }
   ],
   "verify": [
    {
     "check": "each_clean",
     "arg": "$fe"
    }
   ],
   "risk": "high",
   "cost_ms": 2000
  },
  {
   "name": "file_move.each_copy",
   "intent": "file_move",
   "priority": 10,
   "doc": "copia cada item do filtro para o destino \u2014 for_each cp -r",
   "needs": [],
   "pre": [
    {
     "fact": "slot.dest",
     "op": "set"
    },
    {
     "fact": "slot.pat",
     "op": "set"
    },
    {
     "fact": "slot.op",
     "op": "eq",
     "val": "copy"
    }
   ],
   "steps": [
    {
     "cap": "script:file_find",
     "in": {
      "path": "$slot.srcdir",
      "name": "$slot.pat",
      "type": "$slot.type",
      "exclude": "$slot.exclude",
      "limit": "32",
      "icase": "$slot.icase",
      "newer_date": "$slot.newer_date",
      "older_date": "$slot.older_date",
      "newer_min": "$slot.newer",
      "older_min": "$slot.older",
      "time_field": "$slot.tfield"
     },
     "out": "cand"
    },
    {
     "cap": "for_each",
     "in": {
      "from": "$cand",
      "do": "file_op",
      "op": "copy",
      "to_dir": "$slot.dest",
      "max": "32"
     },
     "out": "fe"
    }
   ],
   "verify": [
    {
     "check": "each_clean",
     "arg": "$fe"
    }
   ],
   "risk": "med",
   "cost_ms": 2000
  }
 ]
}